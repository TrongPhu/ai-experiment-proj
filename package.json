{
  "name": "ai-experiment-proj",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:api": "npm --prefix apps/api run start:dev",
    "build": "npm --prefix apps/web run build && npm --prefix apps/api run build",
    "lint": "npm --prefix apps/web run lint && npm --prefix apps/api run lint",
    "test": "npm --prefix apps/api run test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
